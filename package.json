{
	"name": "graphql-passport",
	"version": "0.6.11",
	"packageManager": "npm@11.19.0",
	"description": "Strategy and utilities to use passport.js with GraphQL server",
	"main": "lib/index.js",
	"scripts": {
		"build": "nx exec -- npm run _build -- ",
		"clean": "rimraf lib",
		"lint": "nx exec -- npm run _lint -- ",
		"check-types": "nx exec -- tsc",
		"watch-ts": "tsc -w",
		"prepublishOnly": "run-p lint test build",
		"test": "nx exec -- jest src",
		"test:watch": "jest src --watch",
		"_build": "npm run clean && tsc --emitDeclarationOnly --project tsconfig-build.json && NODE_ENV=build babel src --extensions '.ts,.tsx' --source-maps --out-dir lib --ignore 'src/test'",
		"_lint": "eslint \"src/**/*.{js,ts}\" --quiet"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ericmakesapps/graphql-passport.git"
	},
	"keywords": [
		"graphql",
		"passport",
		"authorization",
		"authentication"
	],
	"authors": [
		"Johannes Kettmann <jkettmann@gmx.net>",
		"Eric Ferreira <eric@ericmakesapps.com>"
	],
	"license": "MIT",
	"dependencies": {
		"passport-strategy": "^1.0.0"
	},
	"devDependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express4": "^1.1.2",
		"@babel/cli": "^8.0.6",
		"@babel/core": "^8.0.7",
		"@babel/plugin-transform-runtime": "^8.0.6",
		"@babel/preset-env": "^8.0.7",
		"@babel/preset-typescript": "^8.0.7",
		"@babel/runtime": "^8.0.7",
		"@nx/workspace": "^24.0.3",
		"@stylistic/eslint-plugin": "^3.1.0",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/express-session": "^1.17.4",
		"@types/jest": "^30.0.0",
		"@types/supertest": "^2.0.11",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"babel-eslint": "^10.1.0",
		"eslint": "^8.57.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jest": "^29.17.0",
		"express-session": "^1.17.2",
		"jest": "^30.5.2",
		"npm-run-all": "^4.1.5",
		"nx": "^24.0.3",
		"passport": "^0.6.0",
		"prettier": "^3.2.4",
		"prettier-plugin-package": "^1.4.0",
		"supertest": "^6.1.6",
		"typescript": "^5.9.3"
	},
	"optionalDependencies": {
		"@types/express": "^4.17.13",
		"@types/passport": "^1.0.9",
		"@types/passport-strategy": "^0.2.35",
		"@types/ws": "^7.4.7",
		"express": "^4.17.1",
		"graphql": "^16.14.2",
		"subscriptions-transport-ws": "^0.11.0",
		"ws": "7.x || 8.x"
	},
	"peerDependencies": {
		"express": "4.x",
		"passport": "0.x",
		"subscriptions-transport-ws": "0.x",
		"ws": "7.x || 8.x"
	},
	"overrides": {
		"undici": "^7.30.0",
		"@types/node": "^22",
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^4.1.0"
		}
	},
	"nx": {
		"targets": {
			"build": {
				"outputs": [
					"{projectRoot}/lib"
				]
			},
			"check-types": {
				"outputs": [
					"{projectRoot}/check-types"
				]
			}
		}
	},
	"jest": {
		"modulePathIgnorePatterns": [
			"<rootDir>/check-types"
		]
	},
	"allowScripts": {
		"@apollo/protobufjs@1.2.8": true,
		"@parcel/watcher@2.6.0": true,
		"nx@23.3.0": true,
		"unrs-resolver@1.12.2": true
	}
}
